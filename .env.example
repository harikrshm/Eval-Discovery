# Groq API key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Database. SQLite (sqlite:///./dev.db) is the local default when this is unset.
# For Postgres use the postgresql:// scheme; a postgres:// URL (as some hosts hand out) is
# normalized to the psycopg driver automatically. This example matches docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eval_discovery

# Comma-separated browser origins allowed by CORS (default: http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173
