# Groq API key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Database: leave unset locally and the backend uses SQLite (sqlite:///./dev.db).
# DATABASE_URL is NOT read from this file: the app and `alembic` read it from the process
# environment, so export it in the shell that runs them (a value here is silently ignored):
#   Git Bash / bash:  export DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eval_discovery
#   PowerShell:       $env:DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eval_discovery"
# That example matches docker-compose.yml. Use the postgresql:// scheme; a postgres:// URL
# (as some hosts hand out) is normalized to the psycopg driver automatically.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eval_discovery

# Comma-separated browser origins allowed by CORS (read from this file; default: http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting behind a reverse proxy. The client IP is the Nth entry from the RIGHT of
# X-Forwarded-For, N = TRUSTED_PROXY_HOPS (default 1; 0 ignores the header). Do not run uvicorn
# with --proxy-headers --forwarded-allow-ips="*". See README "Deploy" for the post-deploy check.
# TRUSTED_PROXY_HOPS=1
# Process-wide LLM request budget per minute (default 600)
# LLM_GLOBAL_PER_MINUTE=600
